# TopstepX API credentials (copy to .env and fill in). The API KEY from your
# dashboard — NOT your account password. .env is gitignored.
TOPSTEPX_USERNAME=your_login
TOPSTEPX_API_KEY=your_api_key
TOPSTEPX_ACCOUNT=

# Optional — only for the jev strategy (python bot.py --strategy jev).
# The decider is any reasoning model, as "backend:model":
#   jev:jev-latest                       TypeSafe's hosted Jev (needs TYPESAFE_AI_API_KEY)
#   mlx:mlx-community/Qwen3-0.6B-4bit    local, in-process on Apple silicon (pip install mlx-lm)
#   openai:<model>                       any OpenAI-compatible server at JEV_OPENAI_URL
#                                        (Ollama, LM Studio, mlx_lm.server, llama.cpp)
JEV_DECIDER=jev:jev-latest
TYPESAFE_AI_API_KEY=
JEV_OPENAI_URL=http://localhost:11434/v1
JEV_LLM_THINK=1                   # 0 = no thinking (faster; for tiny local models)
